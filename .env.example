# IA gratuita: crie uma chave em https://console.groq.com/keys (não pede cartão).
# Sem chave, o chat roda em "modo básico" (só respostas prontas da base, sem IA).
GROQ_API_KEY=

# Opcional: ordem dos modelos (cada um tem cota gratuita própria; quando um esgota, usa o próximo)
# LLM_MODELS=openai/gpt-oss-20b,openai/gpt-oss-120b,llama-3.3-70b-versatile,llama-3.1-8b-instant

# Opcional: outra API compatível com OpenAI (ex.: OpenAI paga, Ollama local)
# LLM_API_KEY=
# LLM_BASE_URL=
# LLM_MODELS=

# Embeddings: auto (modelo local gratuito) | local | openai | none
EMBEDDING_PROVIDER=auto
LOCAL_EMBEDDING_MODEL=Xenova/multilingual-e5-small

PORT=3000
DATA_DIR=./OBPAZ - Banco de Dados-20260417T222334Z-3-001/OBPAZ - Banco de Dados

# Ajustes opcionais
LLM_TEMPERATURE=0.2
RAG_TOP_K=5
SHOW_SOURCES=1
RATE_LIMIT_PER_MINUTE=20

# Registro anônimo das conversas (PostgreSQL gratuito, ex.: Neon). Vazio = não salva nada.
DATABASE_URL=
LOG_RETENTION_DAYS=730
